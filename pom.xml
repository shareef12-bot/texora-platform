<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.texora</groupId>
    <artifactId>texora-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Texora Platform (Parent)</name>
    <description>
        Monorepo parent POM for the Texora platform: 8 core security control-plane
        services, the Quality Automation Platform (QAP), and shared platform foundation
        libraries. See 00-docs/build-plan/ for the full build plan and per-service prompts.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
        <!-- Pin every shared dependency version HERE, once, so every module
             inherits the same version instead of drifting per-service. -->
    </properties>

    <!--
        MODULE LIST — add one line per module as it is actually built.
        Do NOT pre-list modules that don't exist as folders yet; an empty
        <module> entry breaks the build. Uncomment/add as each is created.

        Build order matches 00-OVERVIEW-plan-and-decisions.md Part A.1:
          Platform Foundation first, then SSO -> SEC -> SIEM -> FTP -> DC ->
          LDAP -> VPN -> CGI, with QAP Part A alongside Foundation and
          QAP Part B alongside Integration.
    -->
    
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>21</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
